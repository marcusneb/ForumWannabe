@page "/posts/{Id:int}"
@rendermode InteractiveServer
@inject IPostService PostService
@inject ICommentService CommentService
@using System.Security.Claims

@if (!string.IsNullOrEmpty(error))
{
    <p style="color: red">@error</p>
}
else if (post is null)
{
    <p>Loading...</p>
}
else
{
    <h3>@post.Title</h3>
    <p><i>by @post.AuthorUsername</i></p>
    <p>@post.Content</p>

    <h4>Comments</h4>
    @if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        <ul>
            @foreach (CommentDto comment in comments)
            {
                <li><b>@comment.AuthorUsername:</b> @comment.Body</li>
            }
        </ul>
    }

    <AuthorizeView>
        <Authorized>
            <h4>Add a comment</h4>
            <div>
                <textarea @bind="commentBody" placeholder="Write a comment"></textarea>
            </div>
            <button @onclick="AddCommentAsync">Comment</button>
            <p>@commentMessage</p>
        </Authorized>
        <NotAuthorized>
            <p>Log in to comment.</p>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = null!;

    private PostDto? post;
    private List<CommentDto> comments = new();

    private int userId;
    private string commentBody = "";
    private string commentMessage = "";
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            post = await PostService.GetSingleAsync(Id);
            comments = await CommentService.GetManyAsync(postId: Id);
        }
        catch (Exception e)
        {
            error = e.Message;
        }

        AuthenticationState authenticationState = await State;
        ClaimsPrincipal claimsPrincipal = authenticationState.User;
        if (claimsPrincipal.Identity is null || !claimsPrincipal.Identity.IsAuthenticated)
        {
            return;
        }

        string userIdAsString = claimsPrincipal.Claims.Single(c => c.Type == "Id").Value;
        userId = int.Parse(userIdAsString);
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(commentBody))
        {
            commentMessage = "Write something.";
            return;
        }

        try
        {
            await CommentService.AddCommentAsync(new CreateCommentDto
            {
                Body = commentBody,
                PostId = Id,
                UserId = userId
            });

            commentBody = "";
            commentMessage = "";
            comments = await CommentService.GetManyAsync(postId: Id);
        }
        catch (Exception e)
        {
            commentMessage = e.Message;
        }
    }
}